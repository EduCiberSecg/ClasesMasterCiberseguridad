# Copia a .env (solo para el backend / scripts). NUNCA subas .env a control de versiones.
# La extensión guarda las claves en Configuración (chrome.storage.local), no lee variables de entorno.
CYBERADMIN_API_TOKEN=cambia-esto-por-un-token-largo-aleatorio
CYBERADMIN_PORT=8787
CYBERADMIN_ALLOWED_ORIGIN=chrome-extension://<ID-DE-TU-EXTENSION>
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
